    {
        "id": "fn_procesar_voto",
        "type": "function",
        "z": "tab_votacion",
        "name": "Sumar Voto",
        "func": "let votos = flow.get('votos') || { \"Gilda\": 0, \"Tortilla\": 0, \"Txangurro\": 0, \"Kroketak\": 0 };\nlet opcion = msg.payload;\n\nif (votos.hasOwnProperty(opcion)) {\n    votos[opcion] += 1;\n}\n\nflow.set('votos', votos);\n\n// 1. Notificación para el usuario\nlet msgNotif = {\n    payload: \"Eskerrik asko! Zure botoa: \" + opcion\n};\n\n// 2. Formato de datos para el nodo UI Chart\nlet msgChart = {\n    topic: opcion,\n    payload: votos[opcion]\n};\n\n// 3. Resumen en texto con el desglose total\nlet resumen = `Gilda: ${votos.Gilda} | Tortilla: ${votos.Tortilla} | Txangurro: ${votos.Txangurro} | Kroketak: ${votos.Kroketak}`;\nlet msgTexto = {\n    payload: resumen\n};\n\nreturn [msgNotif, msgChart, msgTexto];",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 250,
        "wires": [
            [
                "ui_notif"
            ],
            [
                "ui_grafico"
            ],
            [
                "ui_resumen_texto"
            ]
        ]
    },
